generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model USERS{
  userid Int @id @default(autoincrement()) @unique
  password String @unique
  firstName String
  lastName String
  email String?
  mobileNo Int
  state String
  country String
  CUSTOMER CUSTOMER?
  AGENT AGENT?

}
model CUSTOMER{
  user USERS @relation(fields: [customerId], references: [userid])
  customerId Int @id @unique
  userBookingHistory userBookingHistory?
}
model AGENT{
  agentId Int @id @unique
  user USERS @relation(fields: [agentId], references: [userid])
}
model userBookingHistory{
  bookingId Int @id @unique @default(autoincrement())
  time DateTime @default(now())
  place String
  pax Int
  price Float
  user CUSTOMER @relation(fields: [bookingId], references: [customerId])
}
model agentTourHistory{
  tourid Int @id @unique
  details String?
  date DateTime
  
}
